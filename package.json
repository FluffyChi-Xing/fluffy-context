{
  "name": "fluffy-context",
  "version": "0.2.0",
  "description": "面向 AI 编程会话的本地上下文运行时 CLI",
  "type": "module",
  "keywords": [
    "context-runtime",
    "ai-agent",
    "coding-agent",
    "developer-tools",
    "cli",
    "context-management",
    "session-resume",
    "knowledge-base",
    "deadend-tracking",
    "snapshot"
  ],
  "bin": {
    "ctx": "dist/src/cli/main.js"
  },
  "exports": {
    ".": "./dist/src/agent/index.js",
    "./agent": "./dist/src/agent/index.js",
    "./version": "./dist/src/version.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "ctx": "npm run build && node dist/src/cli/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
